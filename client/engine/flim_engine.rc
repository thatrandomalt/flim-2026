#include <windows.h>
#include "../common/flim_res.h"
#include "../common/flim_version.h"

// Startup splash: replaces FL's Artwork\Skins\Default\Title.png in this process only.
IDR_SPLASH RCDATA "splash.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     FLIM_VER_Y, FLIM_VER_M, FLIM_VER_D, 0
PRODUCTVERSION  FLIM_VER_Y, FLIM_VER_M, FLIM_VER_D, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName",     "flim"
            VALUE "FileDescription", "flim engine"
            VALUE "FileVersion",     FLIM_VERSION
            VALUE "ProductVersion",  FLIM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
